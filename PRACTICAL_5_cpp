        "\n",
        "print(\"Enter weights of the items:\")\n",
        "for i in range(n):# 0/1 Knapsack using Dynamic Programming\n",
        "\n",
        "# User input\n",
        "n = int(input(\"Enter number of items: \"))\n",
        "\n",
        "weight = []\n",
        "value = []\n",
        "\n",
        "    weight.append(int(input(f\"Weight of item {i + 1}: \")))\n",
        "\n",
        "print(\"Enter values of the items:\")\n",
        "for i in range(n):\n",
        "    value.append(int(input(f\"Value of item {i + 1}: \")))\n",
        "\n",
        "capacity = int(input(\"Enter capacity of knapsack: \"))\n",
        "\n",
        "# Create DP table\n",
        "dp = [[0 for _ in range(capacity + 1)] for _ in range(n + 1)]\n",
        "\n",
        "# Dynamic Programming\n",
        "for i in range(1, n + 1):\n",
        "    for w in range(1, capacity + 1):\n",
        "\n",
        "        if weight[i - 1] <= w:\n",
        "            dp[i][w] = max(\n",
        "                value[i - 1] + dp[i - 1][w - weight[i - 1]],\n",
        "                dp[i - 1][w]\n",
        "            )\n",
        "        else:\n",
        "            dp[i][w] = dp[i - 1][w]\n",
        "\n",
        "# Maximum value\n",
        "print(\"\\nMaximum value:\", dp[n][capacity])\n",
        "\n",
        "# Find selected items\n",
        "w = capacity\n",
        "selected_items = []\n",
        "\n",
        "for i in range(n, 0, -1):\n",
        "    if dp[i][w] != dp[i - 1][w]:\n",
        "        selected_items.append(i)\n",
        "        w -= weight[i - 1]\n",
        "\n",
        "print(\"Selected items:\", selected_items[::-1])\n"
      ],
